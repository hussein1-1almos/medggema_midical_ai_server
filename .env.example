# Official Hugging Face model ID. The first run downloads several GB.
MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it

# Optional: set this to a local folder containing the downloaded model and processor.
# Example: MEDGEMMA_MODEL_DIR=models/medgemma-1.5-4b-it
MEDGEMMA_MODEL_DIR=

# CPU-only tuning. Adjust to your RAM/CPU; first inference may take minutes.
TORCH_THREADS=4
MAX_UPLOAD_BYTES=67108864
MAX_IMAGE_EDGE=1536
MAX_NEW_TOKENS=512
